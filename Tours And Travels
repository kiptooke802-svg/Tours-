<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Discover amazing destinations, unforgettable adventures and extraordinary travel experiences with TourVenture.">
<title>TourVenture | Explore Beyond Limits</title>

<style>
*{margin:0;padding:0;box-sizing:border-box;scroll-behavior:smooth}
body{font-family:Arial,sans-serif;color:#24312b;background:#fff;line-height:1.6}
:root{--green:#123d2b;--gold:#d6a84b;--light:#f5f7f3}
header{background:var(--green);color:white;padding:18px 7%;display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;z-index:1000}
.logo{font-size:25px;font-weight:bold;color:white}
.logo span{color:var(--gold)}
nav{display:flex;gap:25px}
nav a{color:white;text-decoration:none;font-weight:bold;font-size:14px}
nav a:hover{color:var(--gold)}
.menu{display:none;background:none;border:0;color:white;font-size:27px}
.hero{min-height:620px;background:linear-gradient(#0008,#0008),url('https://images.unsplash.com/photo-1516026672322-bc52d61a55d5?auto=format&fit=crop&w=2000&q=85') center/cover;display:flex;align-items:center;padding:8%;color:white}
.hero-content{max-width:720px}
.hero h1{font-size:55px;line-height:1.15;margin-bottom:20px}
.hero p{font-size:19px;margin-bottom:30px}
.btn{display:inline-block;background:var(--gold);color:#173426;padding:14px 25px;border-radius:5px;text-decoration:none;font-weight:bold;margin:5px}
.btn:hover{background:white}
.btn-outline{background:transparent;border:2px solid white;color:white}
section{padding:75px 7%}
.heading{text-align:center;margin-bottom:40px}
.heading h2{font-size:34px;color:var(--green)}
.heading p{color:#777;margin-top:8px}
.about{background:var(--light);display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center}
.about img{width:100%;height:390px;object-fit:cover;border-radius:10px}
.about h2{font-size:34px;color:var(--green);margin-bottom:15px}
.about p{margin-bottom:15px;color:#555}
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:25px}
.card{background:white;border-radius:10px;overflow:hidden;box-shadow:0 5px 20px #00000012;transition:.3s}
.card:hover{transform:translateY(-7px)}
.card img{width:100%;height:220px;object-fit:cover}
.card-content{padding:20px}
.card h3{color:var(--green);margin-bottom:8px}
.card p{color:#666;font-size:14px}
.experiences{background:var(--light)}
.experience-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.experience{background:var(--green);color:white;padding:30px;border-radius:9px;text-align:center}
.experience h3{color:var(--gold);margin:12px 0}
.icon{font-size:38px}
.why{display:grid;grid-template-columns:repeat(3,1fr);gap:25px;text-align:center}
.why div{padding:25px}
.why h3{color:var(--green);margin:10px}
.contact{background:var(--green);color:white;text-align:center}
.contact h2{font-size:34px;color:var(--gold);margin-bottom:15px}
.contact p{margin:10px}
footer{background:#0a261a;color:#ddd;text-align:center;padding:25px}
footer a{color:var(--gold);text-decoration:none}
.whatsapp{position:fixed;bottom:22px;right:22px;background:#25D366;color:white;padding:15px 20px;border-radius:40px;text-decoration:none;font-weight:bold;z-index:1001;box-shadow:0 4px 15px #0003}
@media(max-width:800px){
nav{display:none;position:absolute;top:65px;left:0;width:100%;background:var(--green);flex-direction:column;padding:25px}
nav.show{display:flex}
.menu{display:block}
.hero h1{font-size:39px}
.about{grid-template-columns:1fr}
.cards,.experience-grid,.why{grid-template-columns:1fr}
section{padding:55px 6%}
}
</style>
</head>

<body>

<header>
<div class="logo">Tour<span>Venture</span></div>
<button class="menu" onclick="toggleMenu()">☰</button>
<nav id="nav">
<a href="#home" onclick="closeMenu()">Home</a>
<a href="#about" onclick="closeMenu()">About Us</a>
<a href="#destinations" onclick="closeMenu()">Destinations</a>
<a href="#experiences" onclick="closeMenu()">Experiences</a>
<a href="#contact" onclick="closeMenu()">Contact</a>
</nav>
